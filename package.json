{
  "name": "slow-view-tv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "APP_ORIGIN=http://127.0.0.1:5173 node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "setup:runpod": "bash scripts/runpod-setup.sh",
    "start:runpod": "bash scripts/runpod-start.sh",
    "gpu:check:runpod": "bash scripts/runpod-start.sh gpu-check",
    "test": "node --import tsx --test test/*.test.mjs src/scene/*.test.ts",
    "test:api": "node --test test/server*.mjs",
    "test:e2e": "npm run build && node test/e2e.mjs",
    "test:access": "node test/access.e2e.mjs",
    "test:planning": "node test/planning.e2e.mjs",
    "test:atlas": "node test/atlas.e2e.mjs",
    "test:4k": "SLOWVISTA_SMOKE_FRONTEND=1 node --test test/render4k.smoke.mjs",
    "prepare:map": "node scripts/prepare-map.mjs",
    "review": "node scripts/create-review-demo.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "playwright": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.183.0",
    "topojson-client": "^3.1.0",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "polygon-clipping": "^0.15.7",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "world-atlas": "^2.0.2"
  }
}
