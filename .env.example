# Configure DASHBOARD_PASSWORD privately before opening the panel. No default exists.
# Copy to .env only when needed; never commit actual credentials.
HOST=127.0.0.1
PORT=3001
# Absolute persistent directory for the database and generated videos.
# SLOWVISTA_DATA_DIR=/var/lib/slowvista
# Local disk defaults: WAL / NORMAL. The dedicated RunPod starter instead uses
# DELETE / EXCLUSIVE and checks basic locking for its single-process pilot.
# SLOWVISTA_SQLITE_JOURNAL_MODE=WAL
# SLOWVISTA_SQLITE_LOCKING_MODE=NORMAL
# Password for the panel: a private value of 12–256 characters.
# A public HOST requires this, a previously configured password, or a legacy token.
# DASHBOARD_PASSWORD=
# Legacy alternative. The panel exchanges it for a revocable 12-hour session.
# ADMIN_TOKEN=
# Exact frontend origin(s), separated by commas, for a separately hosted panel.
# CORS_ORIGINS=https://your-site.netlify.app
# Production frontend may be built with the backend's public HTTPS address.
# VITE_API_BASE_URL=https://api.your-domain.example
# Worker always loads the frontend on this machine, never an external website.
# APP_ORIGIN=http://127.0.0.1:3001
CHROMIUM_EXECUTABLE=/usr/bin/chromium
FFMPEG_EXECUTABLE=ffmpeg
FFPROBE_EXECUTABLE=ffprobe
# Real-footage library: maximum upload/import size in MB (default 512).
# MEDIA_MAX_UPLOAD_MB=512
# Enable the reviewed NRK Flåmsbanen torrent on the worker (aria2 required).
# Download starts only from the Trem tab. Keep at least 6 GB free.
# MEDIA_NRK_DOWNLOADS=1
# Optional integrated stock-video discovery; private backend value, never VITE_*.
# PEXELS_API_KEY=
# software uses SwiftShader. native permits the installed Chromium GPU driver;
# it does not provision a GPU or demonstrate hardware acceleration by itself.
CHROMIUM_GPU_MODE=software
# Native headless GPU: auto lets Chromium detect the driver; vulkan requests
# ANGLE/Vulkan without an X11 display. Verify the actual WebGL renderer first.
# CHROMIUM_GPU_BACKEND=auto
# Default uses Chromium's sandbox. This managed environment's SUID helper is
# unavailable; use CHROMIUM_NO_SANDBOX=1 here, not as a general production default.
# CHROMIUM_NO_SANDBOX=1
